---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import FaqList from './FaqList.astro';
import { siteConfig, telHref } from '../config/site';
import { faqPage, originFromSite, plumberId, withContext } from '../lib/schema';

interface ResourceMeta {
  title: string;
  description: string;
  path: string;
  h1: string;
  moneyLink: { label: string; href: string };
  sections: Array<{ heading: string; html: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  related?: Array<{ label: string; href: string }>;
}

interface Props {
  meta: ResourceMeta;
}

const { meta } = Astro.props;
const phone = telHref();
const origin = originFromSite(Astro.site);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', origin).href },
    { '@type': 'ListItem', position: 3, name: meta.h1, item: new URL(meta.path, origin).href },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.h1,
  description: meta.description,
  mainEntityOfPage: new URL(meta.path, origin).href,
  author: { '@id': plumberId(origin) },
  publisher: { '@id': plumberId(origin) },
};

const schemas = [
  breadcrumbSchema,
  articleSchema,
  ...(meta.faqs && meta.faqs.length > 0
    ? [withContext(faqPage(meta.faqs))]
    : []),
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.path}
  ogType="article"
  schemaJson={schemas}
>
  <section class="section">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Resources', href: '/resources/' },
        { label: meta.h1 },
      ]}
    />
    <div class="container prose" style="max-width:46rem">
      <h1>{meta.h1}</h1>
      {
        meta.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <div set:html={s.html} />
          </>
        ))
      }
      {
        meta.related && meta.related.length > 0 && (
          <>
            <h2>Related pages</h2>
            <ul class="related-links">
              {meta.related.map((r) => (
                <li>
                  <a href={r.href}>{r.label}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <div class="section section--tight section--primary" style="border-radius:12px;padding:1.75rem;margin-top:2rem">
        <h2 style="margin:0 0 0.75rem">Need help in Virginia Beach?</h2>
        <p style="margin-bottom:1rem">
          Next step: <a href={meta.moneyLink.href} style="color:#d7ecf7">{meta.moneyLink.label}</a>
          or call anytime.
        </p>
        <div class="btn-group" style="margin-top:0">
          <a class="btn btn--on-dark" href={phone}>Call {siteConfig.phoneDisplay}</a>
          <a class="btn btn--ghost" href="/contact/">Request Service</a>
        </div>
      </div>
    </div>
  </section>
  {meta.faqs && meta.faqs.length > 0 && <FaqList items={meta.faqs} />}
</BaseLayout>
