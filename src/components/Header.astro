---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ServiceIcon from './ServiceIcon.astro';
import { siteConfig, telHref, primaryNav, navServiceGroups } from '../config/site';

const phone = telHref();
---

<header class="site-header" data-site-header>
  <div class="header-shell">
    <div class="header-bar">
      <a class="logo" href="/" aria-label="Virginia Beach Plumbing home">
        <Logo />
      </a>

      <nav class="nav-desktop" aria-label="Primary">
        <ul class="nav-list">
          {
            primaryNav.map((item) =>
              item.href === '/plumbing-services/' ? (
                <li class="has-services" data-nav-services>
                  <a class="nav-top-link" href={item.href}>
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="nav-services-toggle"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="services-menu"
                    data-services-trigger
                  >
                    <span class="visually-hidden">Open services menu</span>
                    <span class="nav-chevron" aria-hidden="true"></span>
                  </button>
                  <div id="services-menu" class="nav-dropdown" data-services-panel>
                    <div class="nav-dropdown__grid">
                      {
                        navServiceGroups.map((group) => (
                          <div class="nav-dropdown__group">
                            <p class="nav-dropdown__label">{group.heading}</p>
                            <ul class="nav-dropdown__list">
                              {group.items.map((service) => (
                                <li>
                                  <a href={service.href}>
                                    <span class="nav-dropdown__icon">
                                      <ServiceIcon href={service.href} />
                                    </span>
                                    <span>
                                      <span class="nav-dropdown__title">{service.title}</span>
                                      <span class="nav-dropdown__desc">{service.description}</span>
                                    </span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))
                      }
                    </div>
                    <a class="nav-dropdown__all" href="/plumbing-services/">
                      View all plumbing services
                      <Icon name="arrow-right" size={16} />
                    </a>
                  </div>
                </li>
              ) : (
                <li>
                  <a href={item.href} class:list={[item.highlight && 'nav-emergency', 'nav-top-link']}>
                    {item.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <div class="header-actions">
        <p class="header-hours">
          <span>24/7 Emergency</span>
        </p>
        <a
          class="btn btn--primary header-call"
          href={phone}
          data-track="phone_click"
          data-track-location="header"
        >
          <Icon name="phone" size={16} />
          <span>{siteConfig.phoneDisplay}</span>
        </a>
        <a
          class="btn btn--secondary header-cta"
          href="/contact/"
          data-track="cta_click"
          data-track-label="request_service_header"
        >
          Request Service
        </a>
        <button
          type="button"
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-haspopup="true"
          data-menu-toggle
        >
          <span class="visually-hidden" data-menu-label>Open menu</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-mobile-menu>
    <nav aria-label="Mobile" class="mobile-menu__inner">
      <ul>
        {
          primaryNav.map((item) =>
            item.href === '/plumbing-services/' ? (
              <li class="mobile-services" data-mobile-services>
                <button
                  type="button"
                  class="mobile-services__trigger"
                  aria-expanded="false"
                  aria-controls="mobile-services-list"
                  data-mobile-services-trigger
                >
                  {item.label}
                  <span class="nav-chevron" aria-hidden="true"></span>
                </button>
                <div id="mobile-services-list" class="mobile-services__panel" hidden data-mobile-services-panel>
                  {
                    navServiceGroups.map((group) => (
                      <div class="mobile-services__group">
                        <p class="mobile-services__label">{group.heading}</p>
                        <ul>
                          {group.items.map((service) => (
                            <li>
                              <a href={service.href}>
                                <span class="mobile-services__icon">
                                  <ServiceIcon href={service.href} />
                                </span>
                                {service.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))
                  }
                  <a class="mobile-services__all" href="/plumbing-services/">View all services</a>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class={item.highlight ? 'nav-emergency' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <a
        class="btn btn--primary btn--block mobile-call"
        href={phone}
        data-track="phone_click"
        data-track-location="mobile_menu"
      >
        <Icon name="phone" size={16} />
        Call {siteConfig.phoneDisplay}
      </a>
      <a
        class="btn btn--secondary btn--block mobile-request"
        href="/contact/"
        data-track="cta_click"
        data-track-label="request_service_mobile_menu"
      >
        Request Service
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    padding: 0.7rem 0 0;
    background: linear-gradient(to bottom, rgba(247, 249, 252, 0.92) 42%, rgba(247, 249, 252, 0));
  }

  .header-shell {
    width: min(100% - 1.25rem, calc(var(--container) + 1.5rem));
    margin-inline: auto;
  }

  .header-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--header-h);
    min-width: 0;
    padding: 0.55rem 0.85rem;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    box-shadow: 0 10px 32px rgba(15, 35, 70, 0.08);
  }

  .header-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    backdrop-filter: blur(22px) saturate(1.2);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);
  }

  .header-bar > * {
    position: relative;
    z-index: 1;
  }

  .site-header.is-compact .header-bar {
    min-height: 64px;
    padding-block: 0.4rem;
    background: rgba(255, 255, 255, 0.94);
    border-color: var(--color-border-strong);
    box-shadow: 0 12px 32px rgba(15, 35, 70, 0.1);
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    min-width: 0;
    flex-shrink: 0;
  }

  .logo:hover {
    color: inherit;
  }

  .nav-desktop {
    display: none;
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.05rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list > li {
    position: static;
  }

  .nav-top-link {
    text-decoration: none;
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    padding: 0.45rem 0.58rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border-radius: 8px;
  }

  .nav-top-link:hover,
  .nav-top-link:focus-visible {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }

  .nav-emergency {
    color: var(--color-emergency-accent) !important;
  }

  .has-services {
    display: flex;
    align-items: center;
  }

  .has-services .nav-top-link {
    padding-right: 0.15rem;
  }

  .nav-services-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 44px;
    margin-left: -0.25rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: 8px;
  }

  .nav-services-toggle:hover,
  .nav-services-toggle:focus-visible {
    color: var(--color-text);
  }

  .nav-chevron {
    display: block;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform 0.18s ease;
  }

  .has-services.is-open .nav-chevron,
  .has-services:hover .nav-services-toggle .nav-chevron,
  .mobile-services__trigger[aria-expanded='true'] .nav-chevron {
    transform: rotate(225deg) translateY(-1px);
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 0.55rem;
    right: 0.55rem;
    z-index: 120;
    width: auto;
    overflow: visible;
    padding: 1.2rem 1.2rem 1.05rem;
    margin: 0;
    background: #ffffff;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    box-shadow: 0 24px 64px rgba(15, 35, 70, 0.12);
    isolation: isolate;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s ease;
  }

  .nav-dropdown::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -16px;
    height: 16px;
  }

  .has-services.is-open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .has-services:hover .nav-dropdown {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
    }
  }

  .nav-dropdown__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 1.15rem 1.35rem;
  }

  .nav-dropdown__group {
    min-width: 0;
  }

  .nav-dropdown__label {
    margin: 0 0 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-2);
  }

  .nav-dropdown__list {
    display: grid;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-dropdown__list a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    align-items: start;
    gap: 0.65rem;
    min-width: 0;
    min-height: 44px;
    padding: 0.45rem 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    border-radius: 10px;
  }

  .nav-dropdown__list a:hover,
  .nav-dropdown__list a:focus-visible {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }

  .nav-dropdown__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: rgba(18, 100, 216, 0.08);
    color: var(--color-cta);
  }

  .nav-dropdown__title {
    display: block;
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .nav-dropdown__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin-top: 0.12rem;
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  .nav-dropdown__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding: 0.45rem 0.2rem;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--color-cta);
    text-decoration: none;
  }

  .nav-dropdown__all:hover,
  .nav-dropdown__all:focus-visible {
    color: var(--color-cta-hover);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .header-hours {
    display: none;
    margin: 0 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-emergency);
    white-space: nowrap;
  }

  .header-call {
    display: none;
    min-height: 44px;
    height: 44px;
    padding-inline: 0.9rem;
    font-size: 0.88rem;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .header-call span {
    white-space: nowrap;
  }

  .header-cta {
    display: none;
    min-height: 44px;
    height: 44px;
    padding-inline: 0.9rem;
    font-size: 0.84rem;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: 0;
    flex-shrink: 0;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .menu-toggle span:not(.visually-hidden) {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    top: calc(0.7rem + var(--header-h) + 0.35rem);
    z-index: 180;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 0.25rem 0.75rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    background: rgba(247, 249, 252, 0.97);
    backdrop-filter: blur(18px);
  }

  .mobile-menu[hidden] {
    display: none !important;
  }

  .mobile-menu__inner {
    width: min(100%, 40rem);
    margin-inline: auto;
    flex: 0 0 auto;
    padding: 0.85rem 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(20px);
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .mobile-menu > nav > ul {
    margin-bottom: var(--space-5);
  }

  .mobile-menu > nav > ul > li > a,
  .mobile-services__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 52px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 650;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .mobile-menu .nav-emergency {
    color: var(--color-emergency-accent);
  }

  .mobile-services__trigger:focus-visible,
  .mobile-menu a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .mobile-services__panel {
    padding: 0.35rem 0 0.7rem;
    overflow: visible;
  }

  .mobile-services__label {
    margin: 0.85rem 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-2);
  }

  .mobile-services__panel ul {
    margin: 0;
  }

  .mobile-services__panel a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    min-height: 48px;
    padding: 0.15rem 0.15rem;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.98rem;
    font-family: var(--font-body);
    border-bottom: 1px solid transparent;
  }

  .mobile-services__icon {
    display: flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    color: var(--color-cta);
    background: rgba(18, 100, 216, 0.08);
    border-radius: 8px;
  }

  .mobile-services__all {
    display: block;
    margin-top: 0.65rem;
    color: var(--color-cta) !important;
    font-weight: 650 !important;
  }

  .mobile-call,
  .mobile-request {
    justify-content: center;
  }

  .mobile-request {
    margin-top: 0.65rem;
  }

  @media (min-width: 900px) {
    .header-call {
      display: inline-flex;
    }
  }

  @media (min-width: 1280px) {
    .nav-desktop {
      display: block;
    }

    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }

    .header-actions {
      margin-left: 0.6rem;
    }

    .header-bar {
      padding-inline: 1rem;
    }
  }

  @media (min-width: 1280px) and (max-width: 1519px) {
    .nav-top-link {
      padding: 0.45rem 0.42rem;
      font-size: 0.84rem;
    }

    .header-hours,
    .header-cta {
      display: none;
    }
  }

  @media (min-width: 1440px) {
    .nav-dropdown__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1.2fr) minmax(0, 1.35fr);
    }
  }

  @media (min-width: 1520px) {
    .header-hours {
      display: block;
    }

    .header-cta {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-site-header]');
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const servicesRoot = document.querySelector('[data-nav-services]');
  const servicesTrigger = document.querySelector('[data-services-trigger]');
  const servicesPanel = document.querySelector('[data-services-panel]');
  const mobileServicesTrigger = document.querySelector('[data-mobile-services-trigger]');
  const mobileServicesPanel = document.querySelector('[data-mobile-services-panel]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  let compactTicking = false;
  let closedByEscape = false;

  function setCompact() {
    if (!header) return;
    header.classList.toggle('is-compact', window.scrollY > 18);
  }

  function onScroll() {
    if (compactTicking) return;
    compactTicking = true;
    requestAnimationFrame(() => {
      setCompact();
      compactTicking = false;
    });
  }

  function lockBody(lock) {
    if (lock) {
      const gap = window.innerWidth - document.documentElement.clientWidth;
      document.body.dataset.navLock = 'true';
      document.body.style.overflow = 'hidden';
      if (gap > 0) document.body.style.paddingRight = `${gap}px`;
    } else {
      delete document.body.dataset.navLock;
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
    }
  }

  function setMobileMenuOpen(open) {
    if (!menuToggle || !mobileMenu) return;
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    const label = menuToggle.querySelector('[data-menu-label]');
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    if (open) {
      mobileMenu.removeAttribute('hidden');
      lockBody(true);
    } else {
      mobileMenu.setAttribute('hidden', '');
      setMobileServicesOpen(false);
      lockBody(false);
    }
  }

  function setDesktopServicesOpen(open) {
    if (!servicesTrigger || !servicesRoot) return;
    if (open) closedByEscape = false;
    servicesTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    servicesRoot.classList.toggle('is-open', open);
  }

  function setMobileServicesOpen(open) {
    if (!mobileServicesTrigger || !mobileServicesPanel) return;
    mobileServicesTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) mobileServicesPanel.removeAttribute('hidden');
    else mobileServicesPanel.setAttribute('hidden', '');
  }

  setCompact();
  window.addEventListener('scroll', onScroll, { passive: true });

  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.hasAttribute('hidden') === false;
    setMobileMenuOpen(!open);
  });

  servicesTrigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = servicesTrigger.getAttribute('aria-expanded') !== 'true';
    setDesktopServicesOpen(open);
  });

  servicesTrigger?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setDesktopServicesOpen(true);
      servicesPanel?.querySelector('a')?.focus();
    }
  });

  if (servicesRoot && finePointer.matches) {
    servicesRoot.addEventListener('mouseenter', () => setDesktopServicesOpen(true));
    servicesRoot.addEventListener('mouseleave', () => {
      if (servicesRoot.contains(document.activeElement)) return;
      setDesktopServicesOpen(false);
    });
  }

  servicesRoot?.addEventListener('focusout', (event) => {
    if (servicesRoot.contains(event.relatedTarget)) return;
    closedByEscape = false;
    setDesktopServicesOpen(false);
  });

  document.addEventListener('click', (event) => {
    if (servicesRoot && !servicesRoot.contains(event.target)) {
      setDesktopServicesOpen(false);
    }
  });

  mobileServicesTrigger?.addEventListener('click', () => {
    const open = mobileServicesTrigger.getAttribute('aria-expanded') !== 'true';
    setMobileServicesOpen(open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (servicesTrigger?.getAttribute('aria-expanded') === 'true') {
      closedByEscape = true;
      setDesktopServicesOpen(false);
      servicesTrigger.focus();
      return;
    }
    if (menuToggle?.getAttribute('aria-expanded') === 'true') {
      setMobileMenuOpen(false);
      menuToggle.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 1280px)').matches) {
      setMobileMenuOpen(false);
    }
  });
</script>
