---
import Logo from './Logo.astro';
import { telHref, primaryNav, phoneLabel } from '../config/site';

const phone = telHref();
const callText = phoneLabel();
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="Virginia Beach Plumbing home">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-list">
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} class={item.highlight ? 'nav-emergency' : undefined}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a
        class="btn btn--text header-call"
        href={phone}
        data-track="phone_click"
        data-track-location="header"
      >
        {callText}
      </a>
      <a
        class="btn btn--primary header-cta"
        href="/contact/"
        data-track="cta_click"
        data-track-label="request_service_header"
      >
        Request Service
      </a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-mobile-menu>
    <nav aria-label="Mobile" class="container">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} class={item.highlight ? 'nav-emergency' : undefined}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a
        class="btn btn--text btn--block mobile-call"
        href={phone}
        data-track="phone_click"
        data-track-location="mobile_menu"
      >
        {callText}
      </a>
      <a
        class="btn btn--primary btn--block mobile-request"
        href="/contact/"
        data-track="cta_click"
        data-track-label="request_service_mobile_menu"
      >
        Request Service
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #f6f4f0;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  @media (min-width: 900px) {
    .site-header {
      background: rgba(246, 244, 240, 0.92);
      backdrop-filter: saturate(1.2) blur(14px);
    }
  }

  .site-header.is-compact {
    background: rgba(255, 255, 255, 0.96);
    border-bottom-color: var(--color-border);
    box-shadow: 0 8px 24px rgba(21, 32, 43, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 84px;
    padding-block: 0.7rem;
    transition: min-height 0.25s ease, padding 0.25s ease;
  }

  .site-header.is-compact .header-inner {
    min-height: 64px;
    padding-block: 0.4rem;
  }

  .site-header.is-compact :global(.brand-logo__mark) {
    width: 36px;
    height: 36px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .logo:hover {
    color: inherit;
  }

  .nav-desktop {
    display: none;
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.15rem 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    padding: 0.45rem 0.7rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    position: relative;
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.55rem;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav-desktop a:hover,
  .nav-desktop a:focus-visible {
    color: var(--color-primary);
  }

  .nav-desktop a:hover::after,
  .nav-desktop a:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-emergency {
    color: var(--color-cta) !important;
  }

  .nav-emergency::after {
    background: var(--color-cta);
  }

  .mobile-menu .nav-emergency {
    color: var(--color-cta);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
  }

  .header-call {
    display: none;
    min-height: 44px;
    height: 44px;
    padding-inline: 0.85rem;
    font-size: 0.9rem;
  }

  .header-cta {
    min-height: 44px;
    height: 44px;
    padding-inline: 1rem;
    font-size: 0.88rem;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #fff;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .menu-toggle span:not(.visually-hidden) {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--color-primary);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background: #fff;
    padding: var(--space-4) 0 var(--space-6);
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .mobile-menu a:not(.btn) {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 52px;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-call {
    justify-content: center;
  }

  .mobile-request {
    margin-top: 0.75rem;
    justify-content: center;
  }

  @media (min-width: 720px) {
    .header-call {
      display: inline-flex;
    }
  }

  @media (min-width: 720px) and (max-width: 1279px) {
    .header-call {
      font-size: 0.82rem;
      padding-inline: 0.55rem;
    }

    .header-cta {
      font-size: 0.82rem;
      padding-inline: 0.75rem;
    }
  }

  @media (min-width: 1280px) {
    .nav-desktop {
      display: block;
    }

    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }

    .header-actions {
      margin-left: var(--space-3);
    }

    .nav-list {
      gap: 0.1rem 0.2rem;
    }
  }

  @media (min-width: 1280px) and (max-width: 1439px) {
    .nav-desktop a {
      padding: 0.45rem 0.45rem;
      font-size: 0.84rem;
    }

    .header-call {
      font-size: 0.84rem;
      padding-inline: 0.6rem;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-site-header]');
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  let compactTicking = false;

  function setCompact() {
    if (!header) return;
    header.classList.toggle('is-compact', window.scrollY > 18);
  }

  function onScroll() {
    if (compactTicking) return;
    compactTicking = true;
    requestAnimationFrame(() => {
      setCompact();
      compactTicking = false;
    });
  }

  function setMobileMenuOpen(open) {
    if (!menuToggle || !mobileMenu) return;
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    const label = menuToggle.querySelector('[data-menu-label]');
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    document.documentElement.classList.toggle('nav-open', open);
    if (open) mobileMenu.removeAttribute('hidden');
    else mobileMenu.setAttribute('hidden', '');
  }

  setCompact();
  window.addEventListener('scroll', onScroll, { passive: true });

  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.hasAttribute('hidden') === false;
    setMobileMenuOpen(!open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMobileMenuOpen(false);
  });
</script>
