---
import Logo from './Logo.astro';
import { siteConfig, telHref, primaryNav, phoneLabel, navServiceGroups } from '../config/site';

const phone = telHref();
const callText = phoneLabel();
---

<header class="site-header" data-site-header>
  <div class="utility-bar">
    <div class="container utility-bar__inner">
      <p class="utility-bar__meta">
        <span>Serving Virginia Beach, VA</span>
        <span class="utility-bar__dot" aria-hidden="true">·</span>
        <span>{siteConfig.hoursDisplay}</span>
      </p>
      <a class="utility-bar__phone" href={phone} data-track="phone_click" data-track-location="utility_bar">
        {siteConfig.phoneDisplay}
      </a>
    </div>
  </div>

  <div class="header-bar">
    <div class="container header-inner">
      <a class="logo" href="/" aria-label="Virginia Beach Plumbing home">
        <Logo />
      </a>

      <nav class="nav-desktop" aria-label="Primary">
        <ul class="nav-list">
          {
            primaryNav.map((item) =>
              item.href === '/plumbing-services/' ? (
                <li class="has-services" data-nav-services>
                  <a class="nav-top-link" href={item.href}>{item.label}</a>
                  <button
                    type="button"
                    class="nav-services-toggle"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="services-menu"
                    data-services-trigger
                  >
                    <span class="visually-hidden">Open services menu</span>
                    <span class="nav-chevron" aria-hidden="true"></span>
                  </button>
                  <div id="services-menu" class="nav-dropdown" data-services-panel>
                    {
                      navServiceGroups.map((group) => (
                        <div class="nav-dropdown__group">
                          <p class="nav-dropdown__label">{group.heading}</p>
                          <ul class="nav-dropdown__list">
                            {group.items.map((service) => (
                              <li>
                                <a href={service.href}>
                                  <span class="nav-dropdown__title">{service.title}</span>
                                  <span class="nav-dropdown__desc">{service.description}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))
                    }
                    <a class="nav-dropdown__all" href="/plumbing-services/">View all services</a>
                  </div>
                </li>
              ) : (
                <li>
                  <a href={item.href} class:list={[item.highlight && 'nav-emergency', 'nav-top-link']}>
                    {item.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <div class="header-actions">
        <a
          class="btn btn--text header-call"
          href={phone}
          data-track="phone_click"
          data-track-location="header"
        >
          {callText}
        </a>
        <a
          class="btn btn--primary header-cta"
          href="/contact/"
          data-track="cta_click"
          data-track-label="request_service_header"
        >
          Request Service
        </a>
        <button
          type="button"
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-haspopup="true"
          data-menu-toggle
        >
          <span class="visually-hidden" data-menu-label>Open menu</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-mobile-menu>
    <nav aria-label="Mobile" class="container">
      <ul>
        {
          primaryNav.map((item) =>
            item.href === '/plumbing-services/' ? (
              <li class="mobile-services" data-mobile-services>
                <button
                  type="button"
                  class="mobile-services__trigger"
                  aria-expanded="false"
                  aria-controls="mobile-services-list"
                  data-mobile-services-trigger
                >
                  {item.label}
                  <span class="nav-chevron" aria-hidden="true"></span>
                </button>
                <div id="mobile-services-list" class="mobile-services__panel" hidden data-mobile-services-panel>
                  <ul>
                    {
                      navServiceGroups.flatMap((group) =>
                        group.items.map((service) => (
                          <li>
                            <a href={service.href}>{service.title}</a>
                          </li>
                        ))
                      )
                    }
                    <li>
                      <a class="mobile-services__all" href="/plumbing-services/">View all services</a>
                    </li>
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class={item.highlight ? 'nav-emergency' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <a
        class="btn btn--secondary btn--block mobile-call"
        href={phone}
        data-track="phone_click"
        data-track-location="mobile_menu"
      >
        {callText}
      </a>
      <a
        class="btn btn--primary btn--block mobile-request"
        href="/contact/"
        data-track="cta_click"
        data-track-label="request_service_mobile_menu"
      >
        Request Service
      </a>
    </nav>
  </div>
</header>

<style>
  .utility-bar {
    background: var(--color-primary);
    color: var(--color-on-dark);
    border-bottom: 3px solid var(--color-cta);
  }

  .utility-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: var(--utility-h);
    padding-block: 0.35rem;
  }

  .utility-bar__meta {
    margin: 0;
    min-width: 0;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(244, 239, 230, 0.86);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .utility-bar__dot {
    margin: 0 0.45rem;
    color: var(--color-cta);
  }

  .utility-bar__phone {
    flex-shrink: 0;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .utility-bar__phone:hover {
    color: #fff;
  }

  .header-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 0 rgba(11, 37, 69, 0.04);
  }

  .site-header.is-compact .header-bar {
    box-shadow: 0 8px 20px rgba(11, 37, 69, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-h);
    padding-block: 0.55rem;
  }

  .site-header.is-compact .header-inner {
    min-height: 64px;
    padding-block: 0.35rem;
  }

  .site-header.is-compact :global(.brand-logo__mark) {
    width: 38px;
    height: 38px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .logo:hover {
    color: inherit;
  }

  .nav-desktop {
    display: none;
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.05rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list > li {
    position: relative;
  }

  .nav-top-link {
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.45rem 0.65rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .nav-top-link:hover,
  .nav-top-link:focus-visible {
    color: var(--color-primary);
  }

  .nav-emergency {
    color: var(--color-cta) !important;
  }

  .has-services {
    display: flex;
    align-items: center;
  }

  .has-services .nav-top-link {
    padding-right: 0.2rem;
  }

  .nav-services-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 44px;
    margin-left: -0.25rem;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .nav-services-toggle:hover,
  .nav-services-toggle:focus-visible {
    color: var(--color-primary);
  }

  .nav-chevron {
    display: block;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform 0.15s ease;
  }

  .has-services.is-open .nav-chevron,
  .has-services:hover .nav-services-toggle .nav-chevron,
  .mobile-services__trigger[aria-expanded='true'] .nav-chevron {
    transform: rotate(225deg) translateY(-1px);
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 120;
    width: min(28rem, calc(100vw - 2rem));
    padding: 0.85rem 1rem 0.9rem;
    margin: 0;
    background: #fff;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-cta);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s ease;
  }

  .nav-dropdown::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    height: 12px;
  }

  .has-services.is-open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav-dropdown__group + .nav-dropdown__group {
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .nav-dropdown__label {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .nav-dropdown__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.1rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-dropdown__list a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.12rem;
    min-height: 44px;
    padding: 0.45rem 0.5rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .nav-dropdown__list a:hover,
  .nav-dropdown__list a:focus-visible {
    color: var(--color-primary);
    background: var(--color-bg);
  }

  .nav-dropdown__title {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .nav-dropdown__desc {
    display: none;
  }

  .nav-dropdown__all {
    display: inline-flex;
    margin-top: 0.75rem;
    padding: 0.4rem 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-cta);
    text-decoration: none;
  }

  .nav-dropdown__all:hover,
  .nav-dropdown__all:focus-visible {
    color: var(--color-cta-hover);
  }

  .mobile-menu .nav-emergency {
    color: var(--color-cta);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
  }

  .header-call {
    display: none;
    min-height: 44px;
    height: 44px;
    padding-inline: 0.7rem;
    font-size: 0.92rem;
  }

  .header-cta {
    min-height: 44px;
    height: 44px;
    padding-inline: 1rem;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: #fff;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .menu-toggle span:not(.visually-hidden) {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--color-primary);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    position: sticky;
    top: var(--header-h);
    z-index: 99;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overflow-x: hidden;
    border-top: 1px solid var(--color-border);
    background: #fff;
    padding: var(--space-4) 0 var(--space-6);
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .mobile-menu > nav > ul {
    margin-bottom: var(--space-5);
  }

  .mobile-menu > nav > ul > li > a,
  .mobile-services__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 52px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .mobile-services__trigger:focus-visible,
  .mobile-menu a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .mobile-services__panel {
    background: var(--color-bg-alt);
  }

  .mobile-services__panel ul {
    margin: 0;
  }

  .mobile-services__panel a {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 48px;
    padding: 0 0.9rem;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1rem;
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-body);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-services__all {
    color: var(--color-cta) !important;
    font-family: var(--font-heading) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
  }

  .mobile-call {
    justify-content: center;
  }

  .mobile-request {
    margin-top: 0.75rem;
    justify-content: center;
  }

  @media (max-width: 419px) {
    .utility-bar__meta span:first-child,
    .utility-bar__dot {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .header-call {
      display: inline-flex;
      white-space: nowrap;
    }
  }

  @media (min-width: 720px) and (max-width: 1279px) {
    .header-call {
      font-size: 0.82rem;
      padding-inline: 0.45rem;
    }

    .header-cta {
      font-size: 0.78rem;
      padding-inline: 0.7rem;
    }
  }

  @media (min-width: 1280px) {
    .nav-desktop {
      display: block;
    }

    .menu-toggle,
    .mobile-menu,
    .header-call {
      display: none !important;
    }

    .header-actions {
      margin-left: var(--space-3);
    }
  }

  @media (min-width: 1280px) and (max-width: 1439px) {
    .nav-top-link {
      padding: 0.45rem 0.42rem;
      font-size: 0.86rem;
    }

    .header-call {
      font-size: 0.84rem;
      padding-inline: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-site-header]');
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const servicesRoot = document.querySelector('[data-nav-services]');
  const servicesTrigger = document.querySelector('[data-services-trigger]');
  const servicesPanel = document.querySelector('[data-services-panel]');
  const mobileServicesTrigger = document.querySelector('[data-mobile-services-trigger]');
  const mobileServicesPanel = document.querySelector('[data-mobile-services-panel]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  let compactTicking = false;
  let closedByEscape = false;

  function setCompact() {
    if (!header) return;
    header.classList.toggle('is-compact', window.scrollY > 18);
  }

  function onScroll() {
    if (compactTicking) return;
    compactTicking = true;
    requestAnimationFrame(() => {
      setCompact();
      compactTicking = false;
    });
  }

  function setMobileMenuOpen(open) {
    if (!menuToggle || !mobileMenu) return;
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    const label = menuToggle.querySelector('[data-menu-label]');
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    if (open) mobileMenu.removeAttribute('hidden');
    else {
      mobileMenu.setAttribute('hidden', '');
      setMobileServicesOpen(false);
    }
  }

  function setDesktopServicesOpen(open) {
    if (!servicesTrigger || !servicesRoot) return;
    if (open) closedByEscape = false;
    servicesTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    servicesRoot.classList.toggle('is-open', open);
  }

  function setMobileServicesOpen(open) {
    if (!mobileServicesTrigger || !mobileServicesPanel) return;
    mobileServicesTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) mobileServicesPanel.removeAttribute('hidden');
    else mobileServicesPanel.setAttribute('hidden', '');
  }

  setCompact();
  window.addEventListener('scroll', onScroll, { passive: true });

  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.hasAttribute('hidden') === false;
    setMobileMenuOpen(!open);
  });

  servicesTrigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = servicesTrigger.getAttribute('aria-expanded') !== 'true';
    setDesktopServicesOpen(open);
  });

  servicesTrigger?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setDesktopServicesOpen(true);
      servicesPanel?.querySelector('a')?.focus();
    }
  });

  if (servicesRoot && finePointer.matches) {
    servicesRoot.addEventListener('mouseenter', () => setDesktopServicesOpen(true));
    servicesRoot.addEventListener('mouseleave', () => {
      if (servicesRoot.contains(document.activeElement)) return;
      setDesktopServicesOpen(false);
    });
  }

  servicesRoot?.addEventListener('focusin', () => {
    if (closedByEscape) return;
    if (window.matchMedia('(min-width: 1280px)').matches) {
      setDesktopServicesOpen(true);
    }
  });

  servicesRoot?.addEventListener('focusout', (event) => {
    if (servicesRoot.contains(event.relatedTarget)) return;
    closedByEscape = false;
    setDesktopServicesOpen(false);
  });

  document.addEventListener('click', (event) => {
    if (servicesRoot && !servicesRoot.contains(event.target)) {
      setDesktopServicesOpen(false);
    }
  });

  mobileServicesTrigger?.addEventListener('click', () => {
    const open = mobileServicesTrigger.getAttribute('aria-expanded') !== 'true';
    setMobileServicesOpen(open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (servicesTrigger?.getAttribute('aria-expanded') === 'true') {
      closedByEscape = true;
      setDesktopServicesOpen(false);
      servicesTrigger.focus();
      return;
    }
    if (menuToggle?.getAttribute('aria-expanded') === 'true') {
      setMobileMenuOpen(false);
      menuToggle.focus();
    }
  });
</script>
