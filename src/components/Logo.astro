---
import BrandMark from './BrandMark.astro';

interface Props {
  variant?: 'default' | 'on-dark';
  compact?: boolean;
  class?: string;
}

const { variant = 'default', compact = false, class: className } = Astro.props;
const onDark = variant === 'on-dark';
---

<span class:list={['brand-logo', onDark && 'brand-logo--on-dark', compact && 'brand-logo--compact', className]}>
  <BrandMark variant={variant} size={44} class="brand-logo__mark" />
  <span class="brand-logo__wordmark">
    <span class="brand-logo__name">Virginia Beach</span>
    <span class="brand-logo__trade">Plumbing</span>
  </span>
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    color: var(--color-primary);
    text-decoration: none;
  }

  .brand-logo :global(.brand-logo__mark) {
    width: 44px;
    height: 44px;
  }

  .brand-logo--on-dark {
    color: #f4efe6;
  }

  .brand-logo__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    min-width: 0;
  }

  .brand-logo__name {
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .brand-logo--on-dark .brand-logo__name {
    color: rgba(244, 239, 230, 0.72);
  }

  .brand-logo__trade {
    font-family: var(--font-heading);
    font-size: 1.28rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: currentColor;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .brand-logo--compact :global(.brand-logo__mark) {
    width: 38px;
    height: 38px;
  }

  .brand-logo--compact .brand-logo__trade {
    font-size: 1.12rem;
  }

  @media (max-width: 400px) {
    .brand-logo {
      gap: 0.5rem;
    }

    .brand-logo :global(.brand-logo__mark) {
      width: 36px;
      height: 36px;
    }

    .brand-logo__trade {
      font-size: 1.08rem;
    }

    .brand-logo__name {
      font-size: 0.58rem;
      letter-spacing: 0.1em;
    }
  }
</style>
