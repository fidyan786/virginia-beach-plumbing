---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site';
import type { PublicChatConfig } from '../lib/chat/types';

const chatConfig: PublicChatConfig = {
  brandName: siteConfig.brandName,
  phoneDisplay: siteConfig.phoneDisplay,
  phoneTel: siteConfig.phoneTel,
  hoursDisplay: siteConfig.hoursDisplay,
  serviceArea: siteConfig.serviceAreaPrimary,
  cityUtilitiesEmergencyPhone: siteConfig.cityUtilitiesEmergencyPhone,
  cityUtilitiesEmergencyUrl: siteConfig.cityUtilitiesEmergencyUrl,
  chatEndpoint: siteConfig.chat.chatEndpoint,
  leadEndpoint: siteConfig.chat.leadEndpoint || siteConfig.formEndpoint,
};
---

<div id="vb-chat" class="vb-chat" data-chat-root data-chat-config={JSON.stringify(chatConfig)}>
  <button
    type="button"
    class="vb-chat__fab"
    data-chat-open
    aria-expanded="false"
    aria-controls="vb-chat-panel"
    aria-label="Open plumbing chat"
  >
    <svg class="vb-chat__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M5.5 17.8 4 20.5l3.1-.8A8.5 8.5 0 1 0 5.5 17.8z"
      />
    </svg>
    <span class="vb-chat__fab-label">Chat</span>
  </button>

  <section
    id="vb-chat-panel"
    class="vb-chat__panel"
    data-chat-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="vb-chat-title"
    hidden
    inert
  >
    <header class="vb-chat__header">
      <div class="vb-chat__brand">
        <span class="vb-chat__mark" aria-hidden="true">
          <BrandMark size={36} />
        </span>
        <div>
          <h2 id="vb-chat-title">{siteConfig.brandName}</h2>
          <p>{siteConfig.hoursDisplay} · Virginia Beach, VA</p>
        </div>
      </div>
      <button type="button" class="vb-chat__close" data-chat-close aria-label="Close chat">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="vb-chat__log" data-chat-log role="log" aria-relevant="additions"></div>
    <div class="vb-chat__live visually-hidden" data-chat-live aria-live="polite" aria-atomic="true"></div>

    <form class="vb-chat__composer" data-chat-form>
      <label class="visually-hidden" for="vb-chat-input">Message</label>
      <textarea
        id="vb-chat-input"
        data-chat-input
        rows="1"
        maxlength="800"
        placeholder="Type a message…"
        autocomplete="off"
        enterkeyhint="send"
      ></textarea>
      <button type="submit" class="vb-chat__send" data-chat-send aria-label="Send message">
        Send
      </button>
    </form>
  </section>
</div>

<script>
  import type { PublicChatConfig } from '../lib/chat/types';

  const root = document.querySelector<HTMLElement>('[data-chat-root]');
  if (root) {
    const cfg = JSON.parse(root.getAttribute('data-chat-config') || '{}') as PublicChatConfig;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-chat-open]');
    let mounting: Promise<void> | null = null;
    let ready = false;

    const mount = () => {
      if (!mounting) {
        mounting = import('../lib/chat/controller').then(({ mountChatWidget }) => {
          mountChatWidget(root, cfg);
          ready = true;
        });
      }
      return mounting;
    };

    openBtn?.addEventListener(
      'click',
      (event) => {
        if (ready) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        void mount().then(() => openBtn.click());
      },
      true
    );

    const scheduleIdle = (cb: () => void) => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(cb, { timeout: 4000 });
      } else {
        window.setTimeout(cb, 2000);
      }
    };
    scheduleIdle(() => {
      void mount();
    });
  }
</script>

<style>
  .vb-chat {
    position: fixed;
    z-index: 110;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    width: auto;
    max-width: calc(100vw - 32px);
    pointer-events: none;
    contain: layout;
  }

  :global(body.has-sticky-cta) .vb-chat {
    bottom: calc(var(--sticky-cta-h) + 12px + env(safe-area-inset-bottom, 0px));
  }

  .vb-chat__fab,
  .vb-chat__panel.is-visible {
    pointer-events: auto;
  }

  .vb-chat__fab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 56px;
    height: 56px;
    padding: 0 0.95rem 0 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fff;
    color: var(--color-cta);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.92rem;
    touch-action: manipulation;
    transition: transform 0.18s ease, background-color 0.15s ease, opacity 0.18s ease;
  }

  .vb-chat.is-open .vb-chat__fab {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
  }

  .vb-chat__fab:hover {
    background: var(--color-primary-soft);
    color: var(--color-cta-hover);
  }

  .vb-chat__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .vb-chat__fab-label {
    padding-right: 0.15rem;
  }

  .vb-chat__panel {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 32px));
    height: min(560px, calc(100dvh - 32px - var(--kb, 0px) - env(safe-area-inset-bottom, 0px)));
    max-height: calc(100dvh - 32px - var(--kb, 0px) - env(safe-area-inset-bottom, 0px));
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    transform-origin: bottom right;
    transition: opacity 0.18s ease, transform 0.18s ease;
    pointer-events: none;
  }

  .vb-chat__panel[hidden] {
    display: none !important;
  }

  :global(body.has-sticky-cta) .vb-chat__panel {
    height: min(560px, calc(100dvh - var(--sticky-cta-h) - 28px - var(--kb, 0px) - env(safe-area-inset-bottom, 0px)));
    max-height: calc(100dvh - var(--sticky-cta-h) - 24px - var(--kb, 0px) - env(safe-area-inset-bottom, 0px));
  }

  .vb-chat__panel.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .vb-chat__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 0.85rem 0.85rem 1rem;
    background: #f0f6ff;
    color: var(--color-text);
  }

  .vb-chat__brand {
    display: flex;
    gap: 0.7rem;
    min-width: 0;
  }

  .vb-chat__mark {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: block;
    overflow: hidden;
    border-radius: 8px;
  }

  .vb-chat__mark svg {
    display: block;
    width: 36px;
    height: 36px;
  }

  .vb-chat__header h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }

  .vb-chat__header p {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .vb-chat__close {
    width: 44px;
    height: 44px;
    margin: -0.2rem -0.2rem 0 0;
    border: 0;
    border-radius: 8px;
    background: rgba(18, 100, 216, 0.08);
    color: var(--color-text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
  }

  .vb-chat__close:hover {
    background: rgba(18, 100, 216, 0.16);
  }

  .vb-chat__log {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.9rem 0.9rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-bg);
  }

  .vb-chat :global(.vb-chat__msg) {
    max-width: 100%;
  }

  .vb-chat :global(.vb-chat__msg--user) {
    align-self: flex-end;
  }

  .vb-chat :global(.vb-chat__who) {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-muted);
    font-family: var(--font-heading);
  }

  .vb-chat :global(.vb-chat__msg--user .vb-chat__who) {
    text-align: right;
  }

  .vb-chat :global(.vb-chat__bubble) {
    display: inline-block;
    max-width: 100%;
    padding: 0.7rem 0.85rem;
    border-radius: 12px;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.45;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .vb-chat :global(.vb-chat__msg--user .vb-chat__bubble) {
    background: var(--color-cta);
    border-color: var(--color-cta);
    color: var(--color-cta-text);
  }

  .vb-chat :global(.vb-chat__bubble--typing) {
    display: inline-flex;
    gap: 0.28rem;
    align-items: center;
    min-height: 18px;
  }

  .vb-chat :global(.vb-chat__bubble--typing span) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-secondary);
    opacity: 0.45;
    animation: vb-chat-dot 1s ease-in-out infinite;
  }

  .vb-chat :global(.vb-chat__bubble--typing span:nth-child(2)) {
    animation-delay: 0.15s;
  }

  .vb-chat :global(.vb-chat__bubble--typing span:nth-child(3)) {
    animation-delay: 0.3s;
  }

  @keyframes vb-chat-dot {
    0%,
    80%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .vb-chat :global(.vb-chat__chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.55rem;
  }

  .vb-chat :global(.vb-chat__chip) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
  }

  .vb-chat :global(.vb-chat__chip:focus-visible),
  .vb-chat__fab:focus-visible,
  .vb-chat__close:focus-visible,
  .vb-chat__send:focus-visible,
  .vb-chat__composer textarea:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .vb-chat :global(.vb-chat__chip:hover) {
    border-color: rgba(59, 168, 224, 0.45);
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .vb-chat :global(.vb-chat__chip--call) {
    background: var(--color-cta);
    border-color: var(--color-cta);
    color: #fff;
  }

  .vb-chat :global(.vb-chat__chip--call:hover) {
    background: var(--color-cta-hover);
    border-color: var(--color-cta-hover);
    color: #fff;
  }

  .vb-chat__composer {
    display: flex;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 0.5rem;
    padding: 0.7rem 0.75rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
    background: #fff;
  }

  .vb-chat__composer textarea {
    flex: 1;
    min-height: 48px;
    max-height: 120px;
    resize: none;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.7rem 0.8rem;
    font: inherit;
    font-size: 1rem;
    color: var(--color-text);
    background: #fff;
  }

  .vb-chat__composer textarea:focus-visible {
    border-color: var(--color-focus);
  }

  .vb-chat__send {
    min-height: 48px;
    min-width: 64px;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-cta);
    color: var(--color-cta-text);
    font-family: var(--font-heading);
    font-weight: 650;
    letter-spacing: 0.01em;
    text-transform: none;
    cursor: pointer;
  }

  .vb-chat__send:hover {
    background: var(--color-cta-hover);
  }

  .vb-chat__send:disabled,
  .vb-chat__composer textarea:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  @media (min-width: 900px) {
    .vb-chat,
    :global(body.has-sticky-cta) .vb-chat {
      bottom: 24px;
      right: max(24px, env(safe-area-inset-right, 0px));
    }

    .vb-chat__panel,
    :global(body.has-sticky-cta) .vb-chat__panel {
      height: min(540px, calc(100vh - 48px - var(--kb, 0px)));
      max-height: calc(100vh - 48px - var(--kb, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vb-chat__fab,
    .vb-chat__panel,
    .vb-chat :global(.vb-chat__bubble--typing span) {
      transition: none;
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .vb-chat__fab-label {
      display: none;
    }

    .vb-chat__fab {
      width: 56px;
      padding: 0;
    }

    .vb-chat__panel {
      width: min(380px, calc(100vw - 32px));
    }
  }
</style>
