---
interface Props {
  name: 'emergency' | 'drain' | 'heater' | 'sewer' | 'leak' | 'repair';
}

const { name } = Astro.props;
---

<svg class="svc-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {
    name === 'emergency' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
        <circle cx="16" cy="16" r="9.2" />
        <path d="M16 11.2v5.1l3.4 2" />
      </g>
    )
  }
  {
    name === 'drain' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
        <circle cx="16" cy="16" r="9.2" />
        <circle cx="16" cy="16" r="3.1" />
        <path d="M16 6.8v3.2M16 22v3.2M6.8 16h3.2M22 16h3.2M9.4 9.4l2.3 2.3M20.3 20.3l2.3 2.3M22.6 9.4l-2.3 2.3M11.7 20.3l-2.3 2.3" stroke-linecap="round" />
      </g>
    )
  }
  {
    name === 'heater' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
        <rect x="10" y="6" width="12" height="20" rx="2.2" />
        <path d="M14 10h4M13.5 21.5h5" />
        <path d="M16 13.2c1.6 1.5 1.6 2.6 0 4.1-1.6-1.5-1.6-2.6 0-4.1z" />
      </g>
    )
  }
  {
    name === 'sewer' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
        <path d="M7 12.5h7.5a3 3 0 0 1 3 3V22" />
        <path d="M7 9.5v6M25 19.5v6" />
        <circle cx="7" cy="12.5" r="2.2" />
        <circle cx="25" cy="19.5" r="2.2" />
      </g>
    )
  }
  {
    name === 'leak' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
        <circle cx="14.5" cy="14.5" r="6.2" />
        <path d="M19.1 19.1 25 25" />
        <path d="M14.5 11.6c0 0-2.4 2.9-2.4 4.4a2.4 2.4 0 1 0 4.8 0c0-1.5-2.4-4.4-2.4-4.4z" />
      </g>
    )
  }
  {
    name === 'repair' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
        <path d="M20.2 8.4a4.6 4.6 0 0 0-6.3 6.3L7.4 21.2a2.1 2.1 0 1 0 3 3l6.5-6.5a4.6 4.6 0 0 0 6.3-6.3l-2.8 2.8-2.2-2.2 2-2.6z" />
      </g>
    )
  }
</svg>

<style>
  .svc-icon {
    width: 28px;
    height: 28px;
    display: block;
  }
</style>
