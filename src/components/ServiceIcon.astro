---
import { serviceIconByHref, type ServiceIconName } from '../lib/service-icons';

interface Props {
  name?: ServiceIconName;
  href?: string;
}

const { name, href } = Astro.props;
const icon = name || (href ? serviceIconByHref[href] : undefined) || 'repair';
---

<svg class="svc-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {
    icon === 'emergency' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M16 6.5 6.8 22.2h18.4L16 6.5z" />
        <path d="M16 13.2v5.2M16 20.8v.6" />
      </g>
    )
  }
  {
    icon === 'drain' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <circle cx="16" cy="16" r="10" />
        <circle cx="16" cy="16" r="3.2" />
        <path d="M16 6v3.4M16 22.6V26M6 16h3.4M22.6 16H26M9.2 9.2l2.4 2.4M20.4 20.4l2.4 2.4M22.8 9.2l-2.4 2.4M11.6 20.4l-2.4 2.4" />
      </g>
    )
  }
  {
    icon === 'heater' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M12.5 8.5h7v16.5h-7z" />
        <path d="M14.5 6.5h3v2h-3z" />
        <path d="M14 12.5h5M13.5 21.5h5" />
        <path d="M16 14.2c1.5 1.3 1.5 2.4 0 3.8-1.5-1.4-1.5-2.5 0-3.8z" />
      </g>
    )
  }
  {
    icon === 'tankless' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <rect x="10" y="7" width="12" height="18" rx="1.4" />
        <path d="M13 11h6M13 14.5h4" />
        <path d="M16 18.2c1.4 1.1 1.4 2.1 0 3.3-1.4-1.2-1.4-2.2 0-3.3z" />
      </g>
    )
  }
  {
    icon === 'sewer' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M6.5 12.5h8a3.2 3.2 0 0 1 3.2 3.2V23" />
        <path d="M6.5 9v7M25.5 19v7" />
        <circle cx="6.5" cy="12.5" r="2.4" />
        <circle cx="25.5" cy="19" r="2.4" />
      </g>
    )
  }
  {
    icon === 'trenchless' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M5 20h22" />
        <path d="M7 20c2.4-6 5.8-9 9-9s6.6 3 9 9" />
        <path d="M11 20v3M16 20v4M21 20v3" />
      </g>
    )
  }
  {
    icon === 'leak' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <circle cx="14.2" cy="14.2" r="6.4" />
        <path d="M18.8 18.8 25.5 25.5" />
        <path d="M14.2 11c0 0-2.6 3.1-2.6 4.7a2.6 2.6 0 1 0 5.2 0c0-1.6-2.6-4.7-2.6-4.7z" />
      </g>
    )
  }
  {
    icon === 'slab' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M5 22h22" />
        <path d="M8 22V12h16v10" />
        <path d="M16 12v-3" />
        <path d="M16 9s-2 2.4-2 3.6a2 2 0 1 0 4 0c0-1.2-2-3.6-2-3.6z" />
      </g>
    )
  }
  {
    icon === 'repair' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M21.6 8.2a5 5 0 0 0-7 7L8 21.8a2.3 2.3 0 1 0 3.2 3.2l6.6-6.6a5 5 0 0 0 7-7L22 13.2l-2.4-2.4 2-2.6z" />
      </g>
    )
  }
  {
    icon === 'commercial' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M8 26V8h16v18" />
        <path d="M5 26h22" />
        <path d="M12 12h2M18 12h2M12 16h2M18 16h2M12 20h2M18 20h2" />
      </g>
    )
  }
  {
    icon === 'residential' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M6 15 16 7l10 8v11H6V15z" />
        <path d="M13 26v-8h6v8" />
      </g>
    )
  }
  {
    icon === 'repiping' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M7 11h10a4 4 0 0 1 4 4v7" />
        <circle cx="7" cy="11" r="2.2" />
        <circle cx="21" cy="22" r="2.2" />
        <path d="M11 11v4.5a2 2 0 0 0 2 2h4" />
      </g>
    )
  }
  {
    icon === 'gas' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M16 7c3.2 3.6 5 6.4 5 9.4A5 5 0 1 1 11 16.4C11 13.4 12.8 10.6 16 7z" />
        <path d="M14.2 18.6c.6 1.2 1.6 1.8 2.8 1.8" />
      </g>
    )
  }
  {
    icon === 'backflow' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M6 16h7l3-5 3 10 3-5h4" />
        <path d="M23 12v8M9 12v8" />
      </g>
    )
  }
  {
    icon === 'sump' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
        <path d="M8 24V14a8 8 0 0 1 16 0v10" />
        <path d="M8 24h16" />
        <path d="M16 14v5" />
        <circle cx="16" cy="20.5" r="1.6" />
      </g>
    )
  }
</svg>

<style>
  .svc-icon {
    width: 28px;
    height: 28px;
    display: block;
  }
</style>
