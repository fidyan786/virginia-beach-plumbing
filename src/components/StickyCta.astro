---
import { siteConfig, telHref } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  variant?: 'default' | 'emergency';
}

const { variant = 'default' } = Astro.props;
const phone = telHref();
const isEmergency = variant === 'emergency';
---

<div class:list={['sticky-cta', isEmergency && 'sticky-cta--emergency']} aria-label="Call now">
  <a
    class="sticky-call"
    href={phone}
    data-track={isEmergency ? 'emergency_call' : 'phone_click'}
    data-track-location="sticky_mobile"
    aria-label={`Call now ${siteConfig.phoneDisplay}`}
  >
    <Icon name="phone" size={18} />
    <span class="sticky-call__copy">
      <span class="sticky-call__label">Call now</span>
      <span class="sticky-call__num">{siteConfig.phoneDisplay}</span>
    </span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    padding: 0.45rem 0.75rem calc(0.45rem + env(safe-area-inset-bottom, 0px));
    min-height: var(--sticky-cta-h);
    background: #fff;
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -12px 32px rgba(15, 35, 70, 0.1);
  }

  .sticky-cta--emergency {
    background: #fff8f6;
    border-top-color: rgba(194, 65, 12, 0.28);
  }

  .sticky-call {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: min(100%, var(--container));
    min-height: 52px;
    margin-inline: auto;
    padding: 0.45rem 1rem;
    border-radius: 12px;
    background: var(--color-cta);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 10px 22px rgba(18, 100, 216, 0.28);
  }

  .sticky-cta--emergency .sticky-call {
    background: var(--color-amber);
    box-shadow: 0 10px 22px rgba(194, 65, 12, 0.3);
  }

  .sticky-call:hover,
  .sticky-call:focus-visible {
    color: #fff;
    text-decoration: none;
    background: var(--color-cta-hover);
  }

  .sticky-cta--emergency .sticky-call:hover,
  .sticky-cta--emergency .sticky-call:focus-visible {
    background: var(--color-amber-hover);
  }

  .sticky-call:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 3px;
  }

  .sticky-call__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }

  .sticky-call__label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sticky-call__num {
    font-size: clamp(0.95rem, 4.2vw, 1.08rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
