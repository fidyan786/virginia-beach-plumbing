---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  items: Faq[];
  heading?: string;
}

const { items, heading = 'Frequently asked questions' } = Astro.props;
---

<section class="section faq-section">
  <div class="container">
    <p class="eyebrow">FAQ</p>
    <h2 class="faq-heading">{heading}</h2>
    <div class="faq">
      {
        items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <div class="faq-panel">
              <div class="faq-panel__inner">
                <p set:html={item.answer} />
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
