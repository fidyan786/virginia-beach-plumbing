---
interface Props {
  variant?: 'default' | 'on-dark';
  size?: number;
  class?: string;
}

const { size = 44, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <rect class="brand-mark__plate" x="0.5" y="0.5" width="47" height="47" rx="12" />
  <path
    d="M14 31.5c0-8.5 6.2-15.5 16.2-15.5"
    fill="none"
    stroke="#1264D8"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <path
    d="M18.5 17c6.8 1.2 11.8 6.4 13 13.4"
    fill="none"
    stroke="#08A8C7"
    stroke-width="2.2"
    stroke-linecap="round"
    opacity="0.9"
  />
  <circle cx="30.2" cy="16" r="2.35" fill="#08A8C7" />
  <circle cx="14" cy="31.5" r="2.35" fill="#0B4EA2" />
</svg>

<style>
  .brand-mark {
    display: block;
    flex-shrink: 0;
  }

  .brand-mark__plate {
    fill: #f0f6ff;
    stroke: #d5dde8;
  }
</style>
