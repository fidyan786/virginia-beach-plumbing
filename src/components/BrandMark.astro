---
interface Props {
  variant?: 'default' | 'on-dark';
  size?: number;
  class?: string;
}

const { variant = 'default', size = 44, class: className } = Astro.props;
const onDark = variant === 'on-dark';
---

<svg
  class:list={['brand-mark', onDark && 'brand-mark--on-dark', className]}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <rect class="brand-mark__plate" width="48" height="48" rx="8" />
  <circle class="brand-mark__ring" cx="24" cy="24" r="17" />
  <g transform="translate(7.4 7.2) scale(1.38)">
    <path
      class="brand-mark__wrench"
      d="M22.7 19.2 13.6 10.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6.1 6.1 9 1.7 4.6C.5 7 .9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"
    />
  </g>
  <path
    class="brand-mark__drop"
    d="M36.2 33.1c0 2.2-1.8 4-4 4s-4-1.8-4-4c0-2.7 4-6.8 4-6.8s4 4.1 4 6.8z"
  />
</svg>

<style>
  .brand-mark {
    display: block;
    flex-shrink: 0;
  }

  .brand-mark__plate {
    fill: var(--color-primary);
  }

  .brand-mark__ring {
    fill: none;
    stroke: var(--color-cta);
    stroke-width: 1.85;
  }

  .brand-mark__wrench {
    fill: #f4efe6;
  }

  .brand-mark__drop {
    fill: var(--color-cta);
  }

  .brand-mark--on-dark .brand-mark__plate {
    fill: #f4efe6;
  }

  .brand-mark--on-dark .brand-mark__wrench {
    fill: var(--color-primary);
  }
</style>
