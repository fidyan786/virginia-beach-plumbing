---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqList from '../../components/FaqList.astro';
import { siteConfig, p0Services, p1Services, telHref } from '../../config/site';
import {
  breadcrumbList,
  faqPage,
  itemListNode,
  originFromSite,
  plumberContractorNode,
  webPageNode,
  withContext,
  offerCatalogNode,
} from '../../lib/schema';

const phone = telHref();
const origin = originFromSite(Astro.site);
const title = 'Plumbing Services in Virginia Beach | Emergency, Drains & Heaters';
const description =
  `Virginia Beach plumbing services for emergencies, drain cleaning, sewer lines, water heaters, leaks, fixture repairs, and commercial work. Call ${siteConfig.phoneDisplay}.`;

const faqs = [
  {
    question: 'Which plumbing service should I choose?',
    answer:
      'Match the symptom: flooding or sewage in the home is emergency plumbing. One slow fixture is drain cleaning. Several fixtures at once may be the sewer line. No hot water is the water heater page. Toilets, faucets, and disposals are plumbing repairs.',
  },
  {
    question: 'Do you handle both homes and businesses?',
    answer:
      'Yes. Residential and commercial plumbing are listed separately so you can add access notes, then pick the specific repair page you need.',
  },
  {
    question: 'Can I just call instead of picking a page?',
    answer: `Yes. Call ${siteConfig.phoneDisplay} anytime. We are open 24/7, and describe the problem. The pages exist so you can land on the right service if you already know what you need.`,
  },
];

const allCards = [...p0Services, ...p1Services];
const schemas = [
  withContext({
    ...plumberContractorNode(origin),
    hasOfferCatalog: offerCatalogNode(origin),
  }),
  withContext(
    webPageNode(origin, {
      name: title,
      description,
      path: '/plumbing-services/',
    })
  ),
  withContext(
    breadcrumbList(origin, [
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/plumbing-services/' },
    ])
  ),
  withContext(
    itemListNode(allCards.map((s) => ({ name: s.title, url: `${origin}${s.href}` })))
  ),
  withContext(faqPage(faqs)),
];
---

<BaseLayout title={title} description={description} canonicalPath="/plumbing-services/" schemaJson={schemas}>
  <section class="section">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
    <div class="container">
      <h1>Plumbing Services in Virginia Beach</h1>
      <p class="lead">
        Pick the service that matches the problem. Each page covers signs, what to expect on a visit, and how to request help.
      </p>
      <p>
        Prefer to talk? <a href={phone} data-track="phone_click">{siteConfig.phoneDisplay}</a>
       . {siteConfig.hoursDisplay}
      </p>

      <div class="prose choose-block">
        <h2>Not sure which page?</h2>
        <ul>
          <li>Water on the floor, a burst pipe, or sewage in the house → <a href="/emergency-plumber/">emergency plumber</a></li>
          <li>One slow sink, tub, or shower → <a href="/drain-cleaning/">drain cleaning</a></li>
          <li>Several fixtures backing up, gurgling toilets, or a sewage smell → <a href="/sewer-line-repair/">sewer line repair</a></li>
          <li>No hot water or a leaking tank → <a href="/water-heaters/">water heaters</a></li>
          <li>Running toilet, dripping faucet, or jammed disposal → <a href="/plumbing-repairs/">plumbing repairs</a></li>
          <li>High bill, damp floor, or water you cannot find → <a href="/leak-detection/">leak detection</a></li>
        </ul>
      </div>

      <h2>Core services</h2>
      <div class="service-grid">
        {
          p0Services.map((s) => (
            <a class="service-card" href={s.href}>
              {s.image && (
                <div class="service-card__media">
                  <img src={s.image} alt={s.imageAlt || ''} width="480" height="300" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="service-card__body">
                <h3>{s.title}</h3>
                <p>{s.description}</p>
                <span class="card-cta">See details</span>
              </div>
            </a>
          ))
        }
      </div>

      <h2 class="section-subhead">Additional services</h2>
      <div class="service-grid">
        {
          p1Services.map((s) => (
            <a class="service-card" href={s.href}>
              {s.image && (
                <div class="service-card__media">
                  <img src={s.image} alt={s.imageAlt || ''} width="480" height="300" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="service-card__body">
                <h3>{s.title}</h3>
                <p>{s.description}</p>
                <span class="card-cta">See details</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <FaqList items={faqs} heading="Plumbing services FAQs" />
</BaseLayout>

<style>
  .choose-block {
    margin: 1.75rem 0 2.25rem;
    max-width: 46rem;
  }
</style>
