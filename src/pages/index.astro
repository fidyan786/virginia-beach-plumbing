---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { siteConfig, homepageServices, allServices, telHref, serviceCtaLabel } from '../config/site';
import { faqPage, originFromSite, plumberContractorNode, websiteNode, withContext, offerCatalogNode } from '../lib/schema';

const phone = telHref();
const origin = originFromSite(Astro.site);
const title = 'Virginia Beach Plumber | 24/7 Emergency, Drains & Water Heaters';
const description =
  `Local plumber in Virginia Beach for clogged drains, water heaters, leaks, sewer work, fixture repairs, and 24/7 emergency plumbing. Call ${siteConfig.phoneDisplay} or request service.`;

const orgSchema = withContext({
  ...plumberContractorNode(origin),
  description,
  hasOfferCatalog: offerCatalogNode(origin),
});

const websiteSchema = withContext(websiteNode(origin));

const webPageSchema = withContext({
  '@type': 'WebPage',
  '@id': `${origin}/#webpage`,
  url: `${origin}/`,
  name: title,
  description,
  inLanguage: 'en-US',
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#plumbing-contractor` },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: `${origin}/images/hero-plumbing.jpg`,
  },
});

const featured: Array<(typeof homepageServices)[number] & { icon: IconName }> = [
  { ...homepageServices[0], icon: 'emergency' },
  { ...homepageServices[1], icon: 'drain' },
  { ...homepageServices[2], icon: 'heater' },
  { ...homepageServices[3], icon: 'sewer' },
  { ...homepageServices[4], icon: 'leak' },
  { ...homepageServices[5], icon: 'repair' },
];

const principles = [
  {
    title: 'Plain explanations',
    copy: 'You hear what we are looking at, what we recommend, and why, without jargon for its own sake.',
  },
  {
    title: 'Start with the problem',
    copy: 'We begin with the leak, the clog, the heater, or the backup in front of us, then decide the next useful step.',
  },
  {
    title: 'Homes and businesses',
    copy: 'Homeowners, landlords, restaurants, offices, hospitality sites, and property managers can all request help.',
  },
  {
    title: 'Virginia Beach coverage',
    copy: 'We serve Virginia Beach. Confirm your ZIP when you call or send a request.',
  },
];

const steps = [
  {
    num: '01',
    title: 'Tell Us What’s Wrong',
    copy: 'Call or send a short request with your ZIP and the plumbing problem you are dealing with.',
  },
  {
    num: '02',
    title: 'We Review the Details',
    copy: 'We confirm the service type and whether the job is in our Virginia Beach coverage area.',
  },
  {
    num: '03',
    title: 'Get Clear Next Steps',
    copy: 'You hear back about scheduling or, when it is urgent, how to reach us right away.',
  },
];

const moreServices = allServices.filter((s) => !homepageServices.some((h) => h.href === s.href));

const homeGuides = [
  {
    href: '/resources/emergency-plumbing-checklist/',
    category: 'Emergency',
    title: 'Emergency plumbing checklist',
    copy: 'Shutoff, safety, and when to call versus waiting.',
  },
  {
    href: '/resources/no-hot-water/',
    category: 'Water',
    title: 'No hot water',
    copy: 'What to check on a tank or tankless unit before you call.',
  },
  {
    href: '/resources/water-heater-leaking/',
    category: 'Water',
    title: 'Water heater leaking',
    copy: 'Tank body vs fitting drips, and when to shut the unit off.',
  },
  {
    href: '/resources/foul-drain-odor/',
    category: 'Drains',
    title: 'Foul drain smell',
    copy: 'Why a drain smells like sewage, and when odor means a larger problem.',
  },
  {
    href: '/resources/recurring-drain-clogs/',
    category: 'Drains',
    title: 'Recurring drain clogs',
    copy: 'Why the same drain keeps clogging, and when snaking is not enough.',
  },
];

const faqs = [
  {
    question: 'Are you a plumbing company or contractor in Virginia Beach?',
    answer: `Yes. Virginia Beach Plumbing is a local plumbing company and contractor for homes and businesses in Virginia Beach. Learn more on the <a href="/about/">about</a> page or browse <a href="/plumbing-services/">plumbing services</a>.`,
  },
  {
    question: 'Are you a 24-hour plumber in Virginia Beach?',
    answer: `Yes. We are open 24/7 for emergency plumbing: burst pipes, major leaks, and sewer backups. Call <a href="${phone}">${siteConfig.phoneDisplay}</a> or see the <a href="/emergency-plumber/">emergency plumbing</a> page.`,
  },
  {
    question: 'What plumbing services do you provide?',
    answer:
      'Core work includes emergency plumbing, drain cleaning, water heaters, sewer line repair, leak detection, fixture repairs, and related residential and commercial plumbing. Browse the <a href="/plumbing-services/">full service list</a>.',
  },
  {
    question: 'How much does a plumber cost in Virginia Beach?',
    answer:
      'It depends on urgency, access, parts, and what we find on site. The <a href="/resources/plumber-cost-virginia-beach/">cost factors</a> guide explains what changes the number. Call or request a visit for a quote that matches the actual job.',
  },
  {
    question: 'Do you work with commercial properties?',
    answer:
      'Yes. We work with businesses, property managers, restaurants, offices, and hospitality. Start on the <a href="/commercial-plumbing/">commercial plumbing</a> page.',
  },
  {
    question: 'Do you service rental properties?',
    answer:
      'Yes. Homeowners, landlords, and property owners can request residential plumbing help. See <a href="/residential-plumbing/">residential plumbing</a>.',
  },
  {
    question: 'What should I do during a plumbing emergency?',
    answer:
      'If it is safe, shut off the water at the main valve, keep electricity away from standing water, and call us. Follow the steps on our <a href="/resources/emergency-plumbing-checklist/">emergency plumbing checklist</a>.',
  },
  {
    question: 'How do I request service?',
    answer: `Call <a href="${phone}">${siteConfig.phoneDisplay}</a> anytime, or submit a short request on the <a href="/contact/">contact</a> page.`,
  },
  {
    question: 'What areas do you serve?',
    answer: `We serve Virginia Beach, Virginia, including areas such as Oceanfront, Kempsville, Lynnhaven, Town Center, and Princess Anne. Confirm coverage on the <a href="/service-areas/">service area</a> page.`,
  },
  {
    question: 'Can I request service online?',
    answer: `Yes. Use the request form on this page or on our <a href="/contact/">contact</a> page. If online requests are unavailable, call ${siteConfig.phoneDisplay}. We are open 24/7 for emergency plumbing help.`,
  },
];

const faqSchema = withContext(faqPage(faqs));
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  ogImage="/images/hero-plumbing.jpg"
  ogImageAlt="Plumber working on copper supply lines under a kitchen sink (illustrative photo)"
  lcpImage="/images/hero-plumbing.jpg"
  schemaJson={[orgSchema, websiteSchema, webPageSchema, faqSchema]}
>
  <section class="home-hero" aria-label="Virginia Beach plumbing hero">
    <div class="home-hero__copy">
      <div class="home-hero__copy-inner">
        <p class="hero-eyebrow">Virginia Beach · Residential &amp; Commercial</p>
        <h1>Plumber in<br /><span class="hero-accent">Virginia Beach</span></h1>
        <p class="hero-lead">
          Emergency leaks, clogged drains, water heaters, sewer work, and fixture repairs for homes and businesses in Virginia Beach. Call or send a short request with your ZIP and the problem.
        </p>
        <div class="btn-group hero-ctas">
          <a class="btn btn--primary btn--hero" href={phone} data-track="phone_click" data-track-location="home_hero">
            <Icon name="phone" />
            Call {siteConfig.phoneDisplay}
          </a>
          <a class="btn btn--secondary btn--hero" href="#request-form" data-track="cta_click" data-track-label="home_hero_request">
            Request Service
          </a>
        </div>
        <p class="hero-note">Open 24/7 for emergency plumbing help</p>
      </div>
    </div>
    <div class="home-hero__media">
      <img
        src="/images/hero-plumbing.jpg"
        alt="Plumber working on copper supply lines under a kitchen sink (illustrative photo)"
        width="1200"
        height="900"
        sizes="(min-width: 980px) 46vw, 100vw"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-status">
        <p class="hero-status__kicker">24/7 Emergency</p>
        <p class="hero-status__place">Virginia Beach</p>
        <a class="hero-status__call" href={phone} data-track="phone_click" data-track-location="home_hero_card">
          Call for help
        </a>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="What you can count on">
    <div class="container trust-strip__grid">
      <article>
        <span class="trust-strip__icon"><Icon name="clock" /></span>
        <strong>24/7 Emergency Support</strong>
        <p>Burst pipes, major leaks, and sewer backups.</p>
      </article>
      <article>
        <span class="trust-strip__icon"><Icon name="home" /></span>
        <strong>Residential &amp; Commercial</strong>
        <p>Homes, rentals, and business plumbing.</p>
      </article>
      <article>
        <span class="trust-strip__icon"><Icon name="map" /></span>
        <strong>Virginia Beach Service</strong>
        <p>We come to you across the city. Confirm your ZIP.</p>
      </article>
      <article>
        <span class="trust-strip__icon"><Icon name="check" /></span>
        <strong>Clear Next Steps</strong>
        <p>Call or send a request with your ZIP and the problem.</p>
      </article>
    </div>
  </section>

  <section class="section home-services">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Services</p>
        <h2>Plumbing work we handle in Virginia Beach</h2>
        <p class="lead">
          Start with the problem. These are the calls we get most. Each page explains signs, what to expect, and how to request help.
        </p>
      </div>
      <ul class="featured-grid">
        {
          featured.map((s, i) => (
            <li data-reveal style={`--d:${i * 70}ms`}>
              <a class="featured-card" href={s.href}>
                <span class="featured-card__icon">
                  <Icon name={s.icon} />
                </span>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
                <span class="card-cta">
                  {s.linkLabel || serviceCtaLabel(s.title)}
                  <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <details class="all-services" data-reveal>
        <summary>All services</summary>
        <ul>
          {
            moreServices.map((s) => (
              <li>
                <a href={s.href}>
                  <span>{s.title}</span>
                  <Icon name="arrow" />
                </a>
              </li>
            ))
          }
          <li>
            <a href="/plumbing-services/">
              <span>View all plumbing services</span>
              <Icon name="arrow" />
            </a>
          </li>
        </ul>
      </details>
    </div>
  </section>

  <section class="section section--emergency home-emergency">
    <div class="container home-emergency__grid">
      <div class="home-emergency__copy" data-reveal>
        <p class="eyebrow">Emergency</p>
        <h2>When Plumbing Can’t Wait</h2>
        <p>
          Burst pipes, major leaks, and sewer backups cannot wait. A water heater dumping water on the floor is urgent; a tank that simply will not heat is usually a scheduled visit. Call and we will sort it. This site does not quote arrival times.
        </p>
        <div class="btn-group">
          <a class="btn btn--emergency" href={phone} data-track="emergency_call" data-track-location="home">
            <Icon name="phone" />
            Call {siteConfig.phoneDisplay}
          </a>
          <a class="btn btn--ghost" href="/emergency-plumber/" data-track="cta_click" data-track-label="home_emergency">
            Emergency plumbing details
          </a>
        </div>
      </div>
      <div class="home-emergency__media" data-reveal>
        <img
          src="/images/emergency-plumbing.jpg"
          alt="Burst copper pipe spraying water (illustrative photo)"
          width="960"
          height="720"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="home-split" aria-label="Residential and commercial plumbing">
    <a class="split-panel" href="/residential-plumbing/" data-reveal>
      <img
        src="/images/residential-plumbing.jpg"
        alt="Residential bathroom vanity and faucet (illustrative photo)"
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <div class="split-panel__content">
        <p class="eyebrow">Residential</p>
        <h2>Homes &amp; rentals</h2>
        <p>Homeowners, landlords, toilets, drains, water heaters, leaks, and fixture repairs.</p>
        <span class="split-panel__cta">Residential Services</span>
      </div>
    </a>
    <a class="split-panel" href="/commercial-plumbing/" data-reveal>
      <img
        src="/images/commercial-plumbing.jpg"
        alt="Commercial utility room with meters, valves, and copper piping (illustrative photo)"
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <div class="split-panel__content">
        <p class="eyebrow">Commercial</p>
        <h2>Businesses</h2>
        <p>Restaurants, offices, hospitality, and property managers — practical commercial plumbing support.</p>
        <span class="split-panel__cta">Commercial Services</span>
      </div>
    </a>
  </section>

  <section class="section home-why">
    <div class="container home-why__grid">
      <div data-reveal>
        <p class="eyebrow">Why choose us</p>
        <h2>Clear work. Straight answers.</h2>
        <p class="lead">
          When something breaks, you need a useful next step. Share the ZIP and what is going wrong. We will say whether it looks urgent, what to shut off if it is safe, and how to request a visit.
        </p>
      </div>
      <ol class="principle-list">
        {
          principles.map((item, i) => (
            <li data-reveal>
              <span class="principle-list__num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--surface home-process">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2>Three steps. No runaround.</h2>
      </div>
      <ol class="process-grid">
        {
          steps.map((step) => (
            <li data-reveal>
              <span class="process-grid__num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section home-local">
    <div class="container home-local__grid">
      <div class="home-local__media" data-reveal>
        <img
          src="/images/home-virginia-beach.jpg"
          alt="Wooden boardwalk through coastal dunes at Virginia Beach at dusk"
          width="1400"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="home-local__copy" data-reveal>
        <p class="eyebrow">Service area</p>
        <h2>Plumbing help across Virginia Beach</h2>
        <p>
          We work with homeowners, landlords, businesses, and property managers in Virginia Beach. Coastal exposure, older housing stock, and storm-season drainage issues show up often here. Neighborhoods below are common call areas, not separate landing pages.
        </p>
        <ul class="place-list">
          {siteConfig.neighborhoods.map((place) => <li>{place}</li>)}
        </ul>
        <a class="text-link" href="/service-areas/">View service area</a>
      </div>
    </div>
  </section>

  <section class="section section--surface home-guides">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Guides</p>
        <h2>Read this before you guess</h2>
        <p class="lead">
          Short pages for the questions people ask while water is still running, or while they decide whether to call.
        </p>
      </div>
      <ul class="guide-grid">
        {
          homeGuides.map((g) => (
            <li data-reveal>
              <a href={g.href}>
                <span class="guide-kicker">{g.category}</span>
                <h3>{g.title}</h3>
                <p>{g.copy}</p>
                <span class="card-cta">
                  Read guide
                  <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="section-more">
        <a class="text-link" href="/resources/">All plumbing guides</a>
      </p>
    </div>
  </section>

  <section class="section home-contact" id="request-form">
    <div class="container home-form">
      <div class="home-form__intro" data-reveal>
        <p class="eyebrow">Request service</p>
        <h2>Need a plumber in Virginia Beach?</h2>
        <p>
          Share your name, phone, ZIP, and the plumbing problem. For flooding, burst pipes, or sewer backups, calling is faster.
        </p>
        <p class="home-form__phone">
          <a href={phone} data-track="phone_click" data-track-location="home_form">{siteConfig.phoneDisplay}</a>
        </p>
        <p class="home-form__hours">{siteConfig.hoursDisplay} · Serving Virginia Beach, VA</p>
        <p class="home-form__prefer">Prefer to call? For burst pipes, major leaks, or sewer backups, calling is faster.</p>
        <a class="btn btn--primary" href={phone} data-track="phone_click" data-track-location="home_form_btn">
          <Icon name="phone" />
          Call {siteConfig.phoneDisplay}
        </a>
      </div>
      <LeadForm variant="routine" heading="Request service" formId="home-lead-form" />
    </div>
  </section>

  <FaqList items={faqs} heading="Frequently asked questions" />

  <section class="section section--primary home-final">
    <div class="container home-final__inner" data-reveal>
      <p class="eyebrow eyebrow--on-dark">Virginia Beach, VA</p>
      <h2>Need a plumber in Virginia Beach?</h2>
      <p>
        Call or send a short request with your ZIP and the problem you’re dealing with.
      </p>
      <div class="btn-group">
        <a class="btn btn--on-dark" href={phone} data-track="phone_click" data-track-location="home_final">
          <Icon name="phone" />
          Call {siteConfig.phoneDisplay}
        </a>
        <a class="btn btn--ghost" href="#request-form" data-track="cta_click" data-track-label="home_final_request">
          Request Service
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    overflow: hidden;
    position: relative;
  }

  .home-hero__copy {
    display: flex;
    align-items: center;
    padding: 1.6rem 0 2.2rem;
    color: var(--color-text);
  }

  .home-hero__copy-inner {
    width: min(100% - 2rem, var(--container));
    margin-inline: auto;
  }

  .hero-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-cta);
  }

  .home-hero h1 {
    margin: 0 0 1.05rem;
    font-size: clamp(2.4rem, 1.1rem + 4.4vw, 4.4rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--color-text);
  }

  .hero-accent {
    background: linear-gradient(90deg, #1264d8 0%, #08a8c7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    margin: 0 0 1.5rem;
    max-width: 36rem;
    font-size: clamp(1.05rem, 0.98rem + 0.3vw, 1.18rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .hero-ctas {
    margin: 0 0 1rem;
    gap: 0.75rem;
  }

  .btn--hero {
    min-height: 52px;
    padding-inline: 1.35rem;
  }

  .hero-note {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .home-hero__media {
    position: relative;
    min-height: 17.5rem;
    margin: 0 1rem 1.25rem;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #eef5ff;
    box-shadow: 0 24px 48px rgba(15, 35, 70, 0.12);
    isolation: isolate;
  }

  .home-hero__media img {
    width: 100%;
    height: 100%;
    min-height: 17.5rem;
    max-height: 26rem;
    object-fit: cover;
    object-position: 62% 40%;
  }

  .home-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 48%, rgba(11, 18, 32, 0.28) 100%),
      radial-gradient(ellipse at 80% 20%, rgba(18, 100, 216, 0.12), transparent 45%);
    pointer-events: none;
  }

  .hero-status {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    padding: 0.95rem 1.05rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 16px 40px rgba(15, 35, 70, 0.14);
    backdrop-filter: blur(16px);
  }

  .hero-status__kicker {
    margin: 0 0 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .hero-status__place {
    margin: 0 0 0.55rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hero-status__call {
    color: var(--color-cta);
    font-weight: 650;
    text-decoration: none;
  }

  .hero-status__call:hover {
    color: var(--color-accent-strong);
  }

  .trust-strip {
    padding: 0.5rem 0 1.75rem;
  }

  .trust-strip__grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
  }

  .trust-strip article {
    padding: 1rem 1.05rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  .trust-strip__icon {
    display: flex;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.65rem;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-strong);
  }

  .trust-strip strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .trust-strip p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .section-intro {
    max-width: 40rem;
    margin-bottom: var(--space-6);
  }

  .featured-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem 1.3rem 1.25rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .featured-card:hover {
    color: inherit;
    text-decoration: none;
    border-color: rgba(18, 100, 216, 0.35);
