---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqList from '../../components/FaqList.astro';
import { siteConfig, telHref } from '../../config/site';
import {
  originFromSite,
  plumberContractorNode,
  plumberId,
  breadcrumbList,
  faqPage,
  withContext,
} from '../../lib/schema';

const phone = telHref();
const title = 'Virginia Beach Plumbing Company | Local Plumbing Contractor';
const description =
  `Virginia Beach Plumbing is a local plumbing company and contractor for homes and businesses — drains, water heaters, leaks, sewer work, and 24/7 emergencies. Call ${siteConfig.phoneDisplay}.`;

const faqs = [
  {
    question: 'Are you a plumbing company or just a lead form?',
    answer: `Virginia Beach Plumbing is a local plumbing company serving Virginia Beach, Virginia. Call <a href="${phone}">${siteConfig.phoneDisplay}</a> or request service with your ZIP and the problem. There is no public storefront listed on this site — we come to the property.`,
  },
  {
    question: 'Do you work as a residential and commercial plumbing contractor?',
    answer:
      'Yes. Homeowners, landlords, restaurants, offices, hospitality sites, and property managers can request help. Start on <a href="/residential-plumbing/">residential</a> or <a href="/commercial-plumbing/">commercial</a>, or browse <a href="/plumbing-services/">all services</a>.',
  },
  {
    question: 'Where do you serve in Virginia Beach?',
    answer:
      'Across Virginia Beach, including areas such as Oceanfront, Kempsville, Lynnhaven, Town Center, Princess Anne, Great Neck, Pungo, Bayside, Red Mill, and Sandbridge. Confirm the ZIP on the <a href="/service-areas/">service area</a> page.',
  },
];

const origin = originFromSite(Astro.site);
const aboutSchema = [
  withContext({
    '@type': 'AboutPage',
    name: title,
    description,
    url: `${origin}/about/`,
    mainEntity: { '@id': plumberId(origin) },
  }),
  withContext(
    breadcrumbList(origin, [
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ])
  ),
  withContext(plumberContractorNode(origin)),
  withContext(faqPage(faqs)),
];
---

<BaseLayout title={title} description={description} canonicalPath="/about/" schemaJson={aboutSchema}>
  <section class="section">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
    <div class="container two-col">
      <div class="prose">
        <h1>Virginia Beach Plumbing Company</h1>
        <p>
          Virginia Beach Plumbing is a local plumbing company and plumbing contractor for homes, rentals, and
          businesses in Virginia Beach, Virginia. We handle the work people actually call about: clogged drains, water
          heaters, leaks, sewer lines, fixture repairs, and after-hours emergencies.
        </p>
        <p>
          Call <a href={phone}>{siteConfig.phoneDisplay}</a> or send a short request with your ZIP and the problem.
          For flooding or sewer backups, start with <a href="/emergency-plumber/">emergency plumbing</a>.
        </p>

        <h2>How we work</h2>
        <p>
          You describe what is happening. We confirm it is in our Virginia Beach coverage area and whether it is
          urgent. Then we talk through the next step: a scheduled visit, an emergency call, or a different path if
          the issue belongs with the city rather than a private plumber.
        </p>
        <p>
          Pricing and timing depend on access, pipe condition, and what we find on site. A website form cannot quote
          those accurately. On a visit, you should hear what we are looking at and why we recommend a repair, a
          replacement, or more diagnosis.
        </p>

        <h2>What we serve</h2>
        <ul>
          <li>
            <a href="/residential-plumbing/">Residential plumbing</a> for homeowners, landlords, and rental turnovers
          </li>
          <li>
            <a href="/commercial-plumbing/">Commercial plumbing</a> for restaurants, offices, hospitality, and property
            managers
          </li>
          <li>
            <a href="/emergency-plumber/">24/7 emergency plumbing</a> for burst pipes, major leaks, and sewer backups
          </li>
        </ul>
        <p>
          The full menu is on <a href="/plumbing-services/">plumbing services</a>. Specialty work such as trenchless
          sewer, slab leaks, gas piping, and backflow testing is listed there when it is the right path after diagnosis.
        </p>

        <h2>Serving Virginia Beach</h2>
        <p>
          We work across Virginia Beach, including areas such as the Oceanfront, Kempsville, Lynnhaven, Town Center,
          Princess Anne, Great Neck, Pungo, Bayside, Red Mill, and Sandbridge. Those are parts of the city we serve, not
          separate offices. Confirm the ZIP on the <a href="/service-areas/">service area</a> page or when you call.
        </p>
        <p>
          Coastal housing, older supply lines, and hospitality properties near the ocean can fail differently than a
          brand-new inland house. That context lives on the relevant service pages and guides, including
          <a href="/resources/coastal-plumbing-challenges-virginia-beach/">coastal plumbing challenges</a>,
          <a href="/resources/vacation-rental-plumbing-virginia-beach/">vacation rental plumbing</a>, and
          <a href="/resources/pipe-repair/">pipe repair</a>.
        </p>

        <h2>Coming to you</h2>
        <p>
          There is no public storefront listed on this website. We come to the property. Phone:
          <a href={phone}>{siteConfig.phoneDisplay}</a>. Hours: {siteConfig.hoursDisplay}.
        </p>
        <p>
          If you need license, insurance, or other credential details for a property manager or HOA, ask when you call
          or request service. We share verified information on request rather than posting unverified claims.
        </p>

        <h2>How to get started</h2>
        <p>
          Call anytime, or use the <a href="/contact/">contact form</a> with your ZIP and service need. For urgent
          flooding or backups, go straight to <a href="/emergency-plumber/">emergency plumbing</a>. Practical steps
          while you wait are on the <a href="/resources/emergency-plumbing-checklist/">emergency checklist</a>.
        </p>
        <div class="btn-group">
          <a class="btn btn--primary" href={phone}>Call {siteConfig.phoneDisplay}</a>
          <a class="btn btn--secondary" href="/contact/">Request Service</a>
        </div>

        <FaqList items={faqs} />
      </div>
      <div class="about-aside">
        <div class="about-card">
          <h2>At a glance</h2>
          <p>
            <strong>Phone</strong>
            <a href={phone}>{siteConfig.phoneDisplay}</a>
          </p>
          <p>
            <strong>Hours</strong>
            {siteConfig.hoursDisplay}
          </p>
          <p>
            <strong>Service area</strong>
            Virginia Beach, VA
          </p>
          <p>
            <strong>How we work</strong>
            We come to the property. There is no public storefront listed on this site.
          </p>
          <div class="btn-group">
            <a class="btn btn--primary" href={phone}>Call now</a>
            <a class="btn btn--secondary" href="/contact/">Request Service</a>
          </div>
        </div>
        <figure class="prose-figure" style="margin:0">
          <img
            src="/images/about-plumbing.jpg"
            alt="Pipe wrenches and copper fittings on a workbench (illustrative photo)"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-aside {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .about-card {
    background: #fff;
    color: var(--color-text);
    padding: 1.5rem 1.4rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .about-card h2 {
    color: var(--color-muted);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .about-card p {
    margin: 0 0 1rem;
    color: var(--color-text-secondary);
  }

  .about-card strong {
    display: block;
    color: var(--color-cta);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .about-card a:not(.btn) {
    color: var(--color-cta);
    font-weight: 700;
    text-decoration: none;
  }

  .about-card a:not(.btn):hover {
    color: var(--color-cta-hover);
  }

  .about-card .btn--primary {
    color: var(--color-cta-text);
  }

  .about-card .btn--primary:hover {
    color: #fff;
  }

  .about-card .btn--secondary {
    background: #fff;
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .about-card .btn--secondary:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }
</style>

