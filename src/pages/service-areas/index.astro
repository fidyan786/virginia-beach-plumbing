---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { siteConfig, telHref } from '../../config/site';
import { originFromSite, plumberContractorNode, breadcrumbList, withContext } from '../../lib/schema';

const phone = telHref();
const origin = originFromSite(Astro.site);
const title = 'Virginia Beach Plumbing Service Area | Neighborhoods We Serve';
const description =
  `Plumbing service in Virginia Beach, VA. Oceanfront, Kempsville, Lynnhaven, Town Center, Pungo, Sandbridge, and more. Call ${siteConfig.phoneDisplay}.`;

const schemas = [
  withContext({
    '@type': 'WebPage',
    name: title,
    description,
    url: `${origin}/service-areas/`,
    about: { '@id': `${origin}/#plumbing-contractor` },
  }),
  withContext(
    breadcrumbList(origin, [
      { name: 'Home', path: '/' },
      { name: 'Service Area', path: '/service-areas/' },
    ])
  ),
  withContext(plumberContractorNode(origin)),
];
---

<BaseLayout title={title} description={description} canonicalPath="/service-areas/" schemaJson={schemas}>
  <section class="section">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Service Area' }]} />
    <div class="container">
      <div class="media-banner">
        <div class="media-banner__img">
          <img
            src="/images/virginia-beach-coast.jpg"
            alt="Coastal Virginia Beach scenery representing the local service area"
            width="900"
            height="560"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="media-banner__body prose">
          <h1>Plumbing Service Area: Virginia Beach</h1>
          <p class="lead">
            We serve Virginia Beach, Virginia. The neighborhoods below are parts of the city we work in.
          </p>
          <div class="btn-group">
            <a class="btn btn--primary" href={phone}>Call {siteConfig.phoneDisplay}</a>
            <a class="btn btn--secondary" href="/contact/">Request Service</a>
          </div>
        </div>
      </div>

      <div class="prose" style="margin-top:2.5rem">
        <h2>Neighborhoods we serve</h2>
        <p>
          We serve Virginia Beach communities including Oceanfront, Kempsville, Lynnhaven, Town Center, Princess Anne, Great Neck, Pungo, Bayside, Red Mill, and Sandbridge. These are parts of the city we work in, not separate office locations.
        </p>
        <h3>Oceanfront and hospitality</h3>
        <p>
          Hotels, restaurants, and short-term rentals near the Oceanfront often need after-hours drain, water heater, and guest-room fixture help. Salt air also wears outdoor hose bibbs, connectors, and exposed valves. See <a href="/commercial-plumbing/">commercial plumbing</a> and the <a href="/resources/coastal-plumbing-challenges-virginia-beach/">coastal plumbing</a> notes.
        </p>
        <h3>Kempsville and slab homes</h3>
        <p>
          Parts of Kempsville and similar suburban neighborhoods have homes on slab foundations. A leak under the slab is a different job than a drip in a crawlspace or a cabinet. If the floor is warm, the meter moves with fixtures off, or you hear water running, start with <a href="/slab-leak-repair/">slab leak repair</a> or <a href="/leak-detection/">leak detection</a>.
        </p>
        <h3>Lynnhaven, Town Center, and Great Neck</h3>
        <p>
          These areas mix houses, condos, and commercial spaces. Older supply lines can mean rusty water or whole-house low pressure, which may be a fixture issue, a hidden leak, or a <a href="/repiping/">repipe</a> conversation after we see the pipe. Share gate codes, unit numbers, and parking notes when you request service.
        </p>
        <h3>Sandbridge and coastal exposure</h3>
        <p>
          Salt air and humidity can wear outdoor piping and fixtures faster. Details are on our <a href="/resources/coastal-plumbing-challenges-virginia-beach/">coastal plumbing</a> guide.
        </p>
        <h3>Pungo and septic vs city sewer</h3>
        <p>
          Some properties in southern Virginia Beach use septic systems rather than city sewer. This site is for plumbing and sewer laterals, not a septic pumping company. Confirm your system type when you call.
        </p>
        <h3>Bayside, Princess Anne, and Red Mill</h3>
        <p>
          Typical calls here are the same mix as the rest of the city: drains, water heaters, toilets, and the occasional sewer backup. If several fixtures fail at once, skip a single-sink snake guess and see <a href="/sewer-line-repair/">sewer line repair</a>.
        </p>
        <h2>Outside Virginia Beach?</h2>
        <p>
          If you are just outside the city, call and we will tell you whether we can take the job.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
