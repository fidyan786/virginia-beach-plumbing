---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { siteConfig, telHref, hasGoogleBusinessProfile, hasRealFormEndpoint } from '../../config/site';
import { originFromSite, plumberContractorNode, breadcrumbList, withContext } from '../../lib/schema';

const phone = telHref();
const title = 'Contact Virginia Beach Plumbing | Request Service';
const description =
  `Contact Virginia Beach Plumbing. Call ${siteConfig.phoneDisplay} anytime (open 24/7) or request service online. Serving Virginia Beach, VA.`;
const hasGbp = hasGoogleBusinessProfile();
const formLive = hasRealFormEndpoint();

const origin = originFromSite(Astro.site);
const schemas = [
  withContext({
    '@type': 'ContactPage',
    name: title,
    description,
    url: `${origin}/contact/`,
    mainEntity: { '@id': `${origin}/#plumbing-contractor` },
  }),
  withContext(
    breadcrumbList(origin, [
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact/' },
    ])
  ),
  withContext(plumberContractorNode(origin)),
];
---

<BaseLayout title={title} description={description} canonicalPath="/contact/" schemaJson={schemas}>
  <section class="section">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
    <div class="container two-col">
      <div>
        <h1>Contact Virginia Beach Plumbing</h1>
        <p class="lead">Call for urgent needs anytime. Use the form for scheduled service, quotes, and commercial requests.</p>

        <div class="contact-cards">
          <div class="contact-block">
            <h2>Phone</h2>
            <p>
              <a class="big-phone" href={phone} data-track="phone_click" data-track-location="contact">
                {siteConfig.phoneDisplay}
              </a>
            </p>
            <p class="muted">Call anytime. We are open 24/7 for plumbing help.</p>
          </div>

          <div class="contact-block">
            <h2>Hours</h2>
            <p><span class="hours-badge">{siteConfig.hoursDisplay}</span></p>
            <p class="muted">Emergency plumbing is included after hours.</p>
          </div>

          <div class="contact-block">
            <h2>Service area</h2>
            <p>{siteConfig.addressLine2}</p>
            <p class="muted">We come to you throughout Virginia Beach. There is no public storefront on this site.</p>
          </div>
        </div>

        {
          hasGbp && siteConfig.googleBusinessProfile.reviewUrl ? (
            <div class="contact-block">
              <h2>Google reviews</h2>
              <p class="muted">If we already completed a job for you, a short review helps neighbors choose a plumber.</p>
              <p>
                <a
                  class="btn btn--secondary"
                  href={siteConfig.googleBusinessProfile.reviewUrl}
                  rel="noopener noreferrer"
                  target="_blank"
                  data-track="cta_click"
                  data-track-label="contact_google_review"
                >
                  Leave a Google review
                </a>
              </p>
            </div>
          ) : null
        }

        {
          !formLive ? (
            <p class="muted small">
              Online requests need a live form endpoint. Until that is connected, calling {siteConfig.phoneDisplay} is the
              surest path.
            </p>
          ) : null
        }

        <figure class="prose-figure">
          <img
            src="/images/about-plumbing.jpg"
            alt="Pipe wrenches and copper fittings on a workbench (illustrative photo)"
            width="800"
            height="500"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <p>
          For urgent flooding or backups, visit
          <a href="/emergency-plumber/">emergency plumbing</a> or call now.
        </p>
      </div>

      <LeadForm variant="routine" heading="Request service" formId="contact-form" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-cards {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 var(--space-6);
  }

  .contact-block {
    margin: 0;
    padding: 1.15rem 1.2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-cta);
    border-radius: var(--radius-card);
  }

  .contact-block h2 {
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .big-phone {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .big-phone:hover {
    color: var(--color-cta);
  }

  .contact-block .muted {
    margin-bottom: 0;
  }
</style>
